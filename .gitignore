# ==========================================
# JAX Transformer From Scratch
# ==========================================

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Jupyter notebooks
.ipynb_checkpoints/

# IDE settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# Machine Learning / JAX
# ==========================================

# Datasets (keep folder structure)
data/*
!data/.gitkeep
!data/README.md

# Model checkpoints and weights
checkpoints/
*.ckpt
*.safetensors
*.pt
*.pth
*.h5
*.onnx

# Experiment logs and results
logs/
runs/
wandb/
mlruns/
tensorboard/
events.out.tfevents.*

# Generated outputs
outputs/
generated/
predictions/

# Profiling and benchmarking
profiles/
profiler/
*.trace.json
*.nsys-rep
*.qdrep

# Temporary files
tmp/
temp/
*.tmp
*.log

# Core dumps
core
core.*
*.core

# Local GPU / CUDA artifacts
*.cubin
*.fatbin
*.ptx

# ==========================================
# Keep important project files
# ==========================================

!README.md
!requirements.txt
!LICENSE